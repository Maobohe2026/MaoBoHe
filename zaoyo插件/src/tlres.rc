/* ????????? TYPELIB ???id=1??? DLL */
#include <windows.h>

1 TYPELIB "zaoyo.tlb"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "zaoyo"
            VALUE "FileDescription",  "zaoyo plugin for Quick Macro"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "zaoyo"
            VALUE "OriginalFilename", "zaoyo.dll"
            VALUE "ProductName",      "zaoyo"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END