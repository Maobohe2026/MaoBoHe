//=======================================获取软件公告=====================================================
Sub 获取软件公告
    //声明变量
    //设置主服务器和备用服务器URL
    Dim mainUrl, backupUrl
    If Form1.ComboBox5.ListIndex = 0 Then 
        mainUrl = "http://api.1wxyun.com/?type=1"
    Else 
        mainUrl = "http://api2.1wxyun.com/?type=1"
    End if
    backupUrl = "http://api2.1wxyun.com/?type=1"
    //构建POST数据
    postData = "Softid=" & softId
    //尝试从主服务器获取数据
    url = mainUrl
    //创建HTTP对象
    Dim http
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    //发送请求并获取响应
    On Error Resume Next //错误处理
    http.Open "POST", url, False
    http.SetRequestHeader "Content-Type", "application/x-www-form-urlencoded"
    http.Send postData
    //检查是否需要使用备用服务器
    If Err.Number <> 0 Then
        //主服务器失败，使用备用服务器
        Err.Clear
        url = backupUrl
        http.Open "POST", url, False
        http.SetRequestHeader "Content-Type", "application/x-www-form-urlencoded"
        http.Send postData
    End If
    //获取响应内容
    If Err.Number = 0 Then
        response = http.ResponseText
        //显示公告内容
        If response <> "" Then
            ret = Plugin.WndEx6_51.MsgBoxEx(0,response,"最近更新内容",0 Or 4096,8000,1)
        Else
            MsgBox "获取公告失败：服务器返回空响应", vbExclamation, "错误"
        End If
    Else
        MsgBox "获取公告失败：" & Err.Description, vbExclamation, "错误"
    End If
    Set http = Nothing
End Sub
