[UIPackage]



[Script]
Global url, postData, response,softId, cardNum, macCode, version
Event Form1.Hotkey1.Hotkey
    StopThread 线程1
    线程1 = BeginThread(主程序)
    Form1.ListBox1.AddItem "启动"
    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
End Event
Event Form1.Hotkey2.Hotkey
    Form1.ListBox1.AddItem "停止"
    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
    StopThread 线程1
End Event
Event Form1.Button4.Click
    StopThread 线程1
    线程1 = BeginThread(主程序)
    Form1.ListBox1.AddItem "启动"
    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
End Event
Event Form1.Button7.Click
    Form1.ListBox1.AddItem "停止"
    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
    StopThread 线程1
End Event
Sub 前置
    Call Plugin.File.CreateFolder("C:\异环")
    Hwnd = Plugin.Window.Find(0, "异环  ")
    If Hwnd = 0 Then 
        Hwnd = Plugin.Window.Foreground() 
    End If
    Call Plugin.Window.Active(Hwnd)   
    sRect = Plugin.Window.GetClientRect(Hwnd)
    dim MyArray
    MyArray = Split(sRect, "|")
    W = Clng(MyArray(0)): H = Clng(MyArray(1))
    R = Clng(MyArray(2)) : B = Clng(MyArray(3))
End Sub
//
Sub OnScriptExit()
    Form1.ListBox1.AddItem "停止1"
    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
End Sub
Sub OnThreadExit()
    Form1.CheckBox4.TextColor = "000000"
    Form1.CheckBox5.TextColor = "000000"
    Form1.CheckBox3.TextColor = "000000"
    Form1.CheckBox7.TextColor = "000000"
    Form1.CheckBox8.TextColor = "000000"
    Form1.CheckBox9.TextColor = "000000"
    Form1.CheckBox10.TextColor="000000"
End Sub
Sub 主页
    Do
        XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Form1.ListBox1.BorderColor="5EAB25"
            Exit Do
        Else 
            KeyPress "ESC", 1
            Delay 3000
        End If
    Loop
End Sub
Sub 主程序
    前置 
    If Form1.CheckBox5.Value = 0 and Form1.CheckBox4.Value = 0 and  Form1.CheckBox3.Value = 0 and Form1.CheckBox7.Value = 0  and  Form1.CheckBox8.Value = 0 and Form1.CheckBox9.Value = 0 and Form1.CheckBox10.Value = 0 Then 
        钓鱼 
    End If
    If Form1.CheckBox5.Value = 1 or Form1.CheckBox4.Value = 1 or Form1.CheckBox3.Value = 1 or Form1.CheckBox7.Value = 1 or  Form1.CheckBox8.Value = 1 or Form1.CheckBox9.Value = 1 or Form1.CheckBox10.Value = 1 Then 
        Form1.ListBox1.AddItem "开始其他选项 如果要钓鱼不要勾选"
        Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
        对话
    End If
End Sub
Sub 钓鱼
    Form1.ListBox1.BorderColor="5EAB25"
    Do
        XY=Plugin.Color.FindMultiColor(W+608,H+67,W+1318,H+81,"AAC428","1|1|AFCC2C,0|2|B4D52F,1|3|B9DE33",0.9)//绿色
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            If 截图 = 0 Then 
                FindColor W+495,H+161,W+509,H+183,"BFBFBF",intX,intY
                If intX > 0 And intY > 0 Then 
                    截图 = 1
                End If
            End If
            Form1.ListBox1.BorderColor="0000FF"
            收鱼 = 1
            甩竿 = 0
            队伍X = 1
            未计数 = 1
            XY=Plugin.Color.FindMultiColor(W+608,H+67,W+1318,H+81,"BAFDFD","1|1|B6FCFD,0|3|ADF9FE,1|4|A8F8FE",0.9)//鱼漂
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
            黄色 = X
            XY=Plugin.Color.FindMultiColor(W+608,H+67,W+1318,H+81,"AAC428","1|1|AFCC2C,0|2|B4D52F,1|3|B9DE33",0.9)//绿色
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
            绿色 = X + 60
            If 黄色 - 绿色 > 18 and 黄色>0 Then 
                KeyUp "D", 1
                KeyDown "A", 1
                //TracePrint "A"&黄色&"-"&绿色
            End If
            If 黄色 - 绿色 < -18 and 黄色>0 Then 
                KeyUp "A", 1
                KeyDown "D", 1
                //TracePrint "D"&黄色&"-"&绿色
            End If
            If -19< 黄色 - 绿色 < 19 Then 
                KeyUp "A", 1
                KeyUp "D", 1
            End If
        Else 
            Form1.ListBox1.BorderColor="FF0000"
            KeyUp "A", 1
            KeyUp "D", 1
            If Form1.CheckBox2.Value = 1 and 截图=1 Then 
            Else
                XY=Plugin.Color.FindMultiColor(W+1815,H+34,W+1888,H+89,"C6C6C3","10|1|C6C4C3,5|5|C6C3C3,6|5|C6C3C3,0|10|C6C4C3,10|10|C6C6C3",0.9)//X
                ZB = InStr(XY,"|")
                X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
                If X > 0 Then 
                Else 
                    XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
                    ZB = InStr(XY,"|")
                    X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
                    If X > 0 Then 
                        Form1.ListBox1.BorderColor="5EAB25"
                    Else 
                        If 收鱼 = 1 Then 
                            TracePrint "收鱼1"
                            循环 = 0
                            截图 = 0
                            队伍X = 0
                            MoveTo W + 1160, H + 500
                            Delay 100
                            LeftClick 1
                            Delay 500
                            ////////////////////////
                            If 未计数 = 1 Then 
                                未计数 = 0
                                拉杆 = 拉杆 + 1
                                If 记录时间 = "" Then 
                                    TracePrint "记录时间为空"
                                    记录时间=Now
                                End If
                                用时 = DateDiff("n", 记录时间, Now)
                                TracePrint 记录时间
                                TracePrint "用时" & 用时 & "分钟" & "钓" & 拉杆 & "条鱼"
                                Form1.ListBox1.AddItem "用时" & 用时 & "分钟" & "钓" & 拉杆 & "条鱼"
                                Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
                            End If
                            /////////////////////////
                        End If
                    End If
                End If
            End If
            If 队伍X = 0 Then 
                XY=Plugin.Color.FindMultiColor(W+1815,H+34,W+1844,H+89,"C6C6C3","10|1|C6C4C3,5|5|C6C3C3,6|5|C6C3C3,0|10|C6C4C3,10|10|C6C6C3",0.9)//队伍X
                ZB = InStr(XY,"|")
                X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
                If X > 0 Then 
                    KeyPress "ESC", 1
                    Delay 1500
                End If
            End If
            XY=Plugin.Color.FindMultiColor(W+853,H+944,W+929,H+996,"E3E3E3","3|0|E3E3E3,4|0|E3E3E3,5|0|E3E3E3,6|0|E3E3E3,9|0|E3E3E3",0.9)//收鱼 
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
                ZB = InStr(XY,"|")
                X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
                If X > 0 Then 
                    Form1.ListBox1.BorderColor="5EAB25"
                Else 
                    If Form1.CheckBox2.Value = 1 and 截图=1 Then 
                        Call Plugin.Pic.PrintScreen(W + 0, H + 0, W + 1920, H + 1080, "C:\异环\大鱼" & Month(Now) & Day(Now) & Hour(Now) & Minute(Now) & Second(Now) & ".jpg")
                    end If
                    TracePrint "收鱼2"
                    循环 = 0
                    MoveTo W + 1160, H + 800
                    Delay 100
                    LeftClick 2
                    Delay 1000
                    收鱼 = 0
                    队伍X = 0
                    截图 = 0
                    ////////////////////////
                    If 未计数 = 1 Then 
                        未计数 = 0
                        拉杆 = 拉杆 + 1
                        If 记录时间 = "" Then 
                            TracePrint "记录时间为空"
                            记录时间=Now
                        End If
                        用时 = DateDiff("n", 记录时间, Now)
                        TracePrint 记录时间
                        TracePrint "用时" & 用时 & "分钟" & "钓" & 拉杆 & "条鱼"
                        Form1.ListBox1.AddItem "用时" & 用时 & "分钟" & "钓" & 拉杆 & "条鱼"
                        Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
                    End If
                    /////////////////////////
                End If
            End If
            XY=Plugin.Color.FindMultiColor(W+1600,H+100,W+1830,H+148,"1B1B1B","-9|1|1B1B1B,119|6|FFFFFF,124|6|FFFFFF,2|10|1B1B1B,-9|12|1B1B1B",1)//ESC界面
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                KeyPress "ESC", 1
                Delay 2100
            End If
            XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                收鱼 = 0
                KeyUp "A", 1
                KeyUp "D", 1
                KeyPress "F", 1
                Delay 1000
            End If
            XY=Plugin.Color.FindMultiColor(W+1555,H+922,W+1592,H+956,"2C2C2C","7|0|2C2C2C,15|0|2C2C2C,2|9|2C2C2C,12|9|2C2C2C,1|15|2C2C2C,12|16|2C2C2C",1)//开始钓鱼
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                TracePrint "开始钓鱼"
                Form1.ListBox1.AddItem "开始钓鱼"
                Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
                MoveTo W + 1721, H + 770 : Delay 100 : LeftClick 1 : Delay 2100//选择鱼饵
                //                If Form1.CheckBox4.Value = 1 Then 
                //                    MoveTo W + 948, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                //                    MoveTo W + 830, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                //                End If
                //                If Form1.CheckBox5.Value = 1 Then 
                //                    MoveTo W + 948, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                //                    MoveTo W + 1070, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                //                End If
                MoveTo W + 948, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                MoveTo W + 720, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
                MoveTo W + 1171, H + 708 : Delay 100 : LeftClick 1 : Delay 2100   //选择
                MoveTo W + 1171, H + 708 : Delay 100 : LeftClick 1 : Delay 2100//不合适确认
                XY=Plugin.Color.FindMultiColor(W+40,H+110,W+654,H+595,"D6A2E7","8|0|FADDFF,14|0|F8E1FF,9|7|A97FE4,13|8|8E58DD,0|9|823FCA",0.9)
                ZB = InStr(XY,"|")
                X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
                If X > 0 Then 
                    Form1.ListBox1.AddItem "购买鱼饵"
                    Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
                    MoveTo X,Y : Delay 100 : LeftClick 1 : Delay 2100
                    MoveTo W+1830,H+952 : Delay 100 : LeftClick 1 : Delay 2100
                    MoveTo W + 1622, H + 1030 : Delay 100 : LeftClick 1 : Delay 2100
                    MoveTo W+1171,H+708 : Delay 100 : LeftClick 1 : Delay 2100
                    LeftClick 1 : Delay 2100
                    主页
                Else
                    MoveTo W + 1555, H + 922 : Delay 100 : LeftClick 1 : Delay 2100  //开始钓鱼
                    MoveTo W + 1171, H + 708 : Delay 100 : LeftClick 1 : Delay 2100   //不合适确认
                End If
            End If
            XY=Plugin.Color.FindMultiColor(W+1728,H+916,W+1827,H+1015,"FF7C20","1|0|FF7C20,0|1|FF7C20,1|1|FF7C20",0.8)//拉杆
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                甩竿 = 0
                循环 = 0
                KeyPress "F", 1
                Delay 500
            End If
            XY=Plugin.Color.FindMultiColor(W+1363,H+944,W+1798,H+1012,"FFFFFF","2|0|FFFFFF,1|1|FFFFFF,0|2|FFFFFF,2|2|FFFFFF,1|3|FFFFFF",1)//F图标-甩竿
            ZB = InStr(XY,"|")
            X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
            If X > 0 Then 
                TracePrint "甩竿"&甩竿
                甩竿=甩竿+1
                KeyPress "F", 1
                Delay 1000
            End If
        End If
        Rem 主循环
        If 甩竿 > 8 Then 
            Form1.ListBox1.AddItem "再等8秒"
            Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
        End If
        If 甩竿 > 12 Then 
            If Form1.CheckBox1.Value = 1 Then 
                Exit Sub
            Else
                Form1.ListBox1.AddItem "鱼饵没了 购买鱼饵"
                Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
                Call 万能鱼饵
            End If
        End If
        循环 = 循环 + 1
        TracePrint 循环
        If 循环 > 2000 Then 
            收鱼 = 0
            KeyUp "A", 1
            KeyUp "D", 1
            循环=0
            主页 
            Form1.ListBox1.AddItem "出现意外情况 回到游戏主页开始"
            Form1.ListBox1.ListIndex = Form1.ListBox1.ListCount - 1
        End If
    Loop
End Sub
Sub 万能鱼饵
    Form1.ListBox1.BorderColor="00FFFF"
    收鱼 = 0
    KeyUp "A", 1
    KeyUp "D", 1
    甩竿=0
    TracePrint "没有鱼饵了"
    KeyPress "Q", 3
    Delay 2500
    MoveTo W+151,H+412 : Delay 100 : LeftClick 1 : Delay 2100
    MoveTo W+1075,H+965 : Delay 100 : LeftClick 1 : Delay 2100
    MoveTo W+1171,H+708 : Delay 100 : LeftClick 1 : Delay 2100
    LeftClick 1 : Delay 2100
    KeyPress "ESC", 1
    Delay 2100
    For 3
        XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+1528,H+105,W+1693,H+148,"1B1B1B","4|1|1B1B1B,10|1|1B1B1B,-1|5|1B1B1B,4|6|1B1B1B,10|7|1B1B1B",1)//ESC界面
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            KeyPress "ESC", 1
            Delay 2100
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit For
        End If
        XY=Plugin.Color.FindMultiColor(W+1363,H+944,W+1440,H+1012,"FFFFFF","13|11|FFFFFF,-12|14|FFFFFF,5|23|FFFFFF,14|23|FFFFFF,-13|37|FFFFFF",1)//R图标-甩竿
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit For
        Else 
            KeyPress "ESC", 1
            Delay 2100
        End If
    Next
    XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
    ZB = InStr(XY,"|")
    X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
    If X > 0 Then 
        Exit Sub
    End If
    KeyPress "R", 3
    Delay 2500
    XY=Plugin.Color.FindMultiColor(W+40,H+110,W+654,H+595,"D6A2E7","8|0|FADDFF,14|0|F8E1FF,9|7|A97FE4,13|8|8E58DD,0|9|823FCA",0.9)
    ZB = InStr(XY,"|")
    X = Clng(Left(XY, ZB - 1)) : Y = Clng(Right(XY, Len(XY) - ZB))
    If X > 0 Then 
        MoveTo X,Y : Delay 100 : LeftClick 1 : Delay 2100
    End If
    MoveTo W+1830,H+952 : Delay 100 : LeftClick 1 : Delay 2100
    MoveTo W + 1622, H + 1030 : Delay 100 : LeftClick 1 : Delay 2100
    MoveTo W+1171,H+708 : Delay 100 : LeftClick 1 : Delay 2100
    LeftClick 1 : Delay 2100
    KeyPress "ESC", 1
    Delay 2100
    For 3
        XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+1528,H+105,W+1693,H+148,"1B1B1B","4|1|1B1B1B,10|1|1B1B1B,-1|5|1B1B1B,4|6|1B1B1B,10|7|1B1B1B",1)//ESC界面
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            KeyPress "ESC", 1
            Delay 2100
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+1363,H+944,W+1440,H+1012,"FFFFFF","13|11|FFFFFF,-12|14|FFFFFF,5|23|FFFFFF,14|23|FFFFFF,-13|37|FFFFFF",1)//R图标-甩竿
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit For
        Else 
            KeyPress "ESC", 1
            Delay 2100
        End If
    Next
    XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
    ZB = InStr(XY,"|")
    X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
    If X > 0 Then 
        Exit Sub
    End If
    KeyPress "E", 3
    Delay 2100
    MoveTo W + 948, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
    MoveTo W + 720, H + 524 : Delay 100 : LeftClick 1 : Delay 1000
    MoveTo W + 1166, H + 708 : Delay 100 : LeftClick 1 : Delay 2100
    For 3
        XY=Plugin.Color.FindMultiColor(W+283,H+77,W+309,H+98,"F5F5F5","1|0|F5F5F5,2|0|F5F5F5,3|0|F5F5F5",1)//主页
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+1528,H+105,W+1693,H+148,"1B1B1B","4|1|1B1B1B,10|1|1B1B1B,-1|5|1B1B1B,4|6|1B1B1B,10|7|1B1B1B",1)//ESC界面
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            KeyPress "ESC", 1
            Delay 2100
            Exit Sub
        End If
        XY=Plugin.Color.FindMultiColor(W+1363,H+944,W+1440,H+1012,"FFFFFF","13|11|FFFFFF,-12|14|FFFFFF,5|23|FFFFFF,14|23|FFFFFF,-13|37|FFFFFF",1)//R图标-甩竿
        ZB = InStr(XY,"|")
        X = Clng(Left(XY, ZB - 1)): Y = Clng(Right(XY, Len(XY) - ZB))
        If X > 0 Then 
            Exit For
        Else 
            KeyPress "ESC", 1
            Delay 2100
        End If
